{
    "name" : "ekapusta/doctrine-custom-types-bundle",
    "description" : "Add custom types like MySQL's enum",
    "type" : "symfony-bundle",
    "autoload" : {
        "psr-4" : {
            "Ekapusta\\DoctrineCustomTypesBundle\\" : ""
        }
    },
    "require" : {
        "php" : "^8.2",
        "doctrine/dbal" : "^2.13 || ^3.0",
        "doctrine/doctrine-bundle" : "^2.5",
        "doctrine/orm" : "^2.11",
        "symfony/dependency-injection" : "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel" : "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev" : {
        "symfony/phpunit-bridge" : "^6.4 || ^7.0 || ^8.0"
    },
    "scripts" : {
        "fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php $(git ls-files '*.php') $(git ls-files --exclude-standard --others '*.php')",
        "f": "@fix",
        "test": "simple-phpunit --columns max --color=always",
        "coverage": "XDEBUG_MODE=coverage simple-phpunit --coverage-html ./.coverage --coverage-text"
    },
    "license" : "MIT",
    "authors" : [{
            "name" : "Alexander Ustimenko",
            "email" : "ustimenko.alexander@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": true
        }
    }
}
